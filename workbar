// ===== Cascader 级联选择器 引擎 =====
// 从单个 tree-item 元素提取标签名（排除 arrow / badge / 编辑图标）
function extractTreeItemLabel(item) {
  var dl = item.getAttribute && item.getAttribute('data-label');
  if (dl && dl.trim()) return dl.trim();
  var spans = item.querySelectorAll(':scope > span');
  for (var i = 0; i < spans.length; i++) {
    var s = spans[i];
    if (s.classList.contains('arrow') || s.classList.contains('tree-badge') || s.classList.contains('tree-edit')) continue;
    var t = (s.textContent || '').trim();
    if (t) return t;
  }
  // 没有独立 span（如叶子直接写文本）时，仅取文本节点/非图标元素文本
  var txt = '';
  Array.prototype.forEach.call(item.childNodes, function(n){
    if (n.nodeType === 3) txt += n.textContent;
    else if (n.nodeType === 1 && !n.classList.contains('arrow') && !n.classList.contains('tree-badge') && !n.classList.contains('tree-edit')) txt += n.textContent;
  });
  return txt.replace(/▶/g, '').trim();
}

// 递归解析某个树容器（.tree-children 或维度根容器）的直接子级 tree-item
function parseTreeChildren(container) {
  var nodes = [];
  var child = container.firstElementChild;
  while (child) {
    if (child.classList && child.classList.contains('tree-item')) {
      var label = extractTreeItemLabel(child);
      // 跳过“+ 新增...”等操作项
      if (label && label.indexOf('+') !== 0) {
        var node = { label: label };
        var sib = child.nextElementSibling;
        if (sib && sib.classList && sib.classList.contains('tree-children')) {
          var kids = parseTreeChildren(sib);
          if (kids.length) node.children = kids;
        }
        nodes.push(node);
      }
    }
    child = child.nextElementSibling;
  }
  return nodes;
}

// 将“标签管理”各维度树（DOM）解析为级联数据，保证与标签维度树完全一致
function buildTagTree() {
  var dims = [
    { id: 'tag-tree-genre',  label: '题材' },
    { id: 'tag-tree-scene',  label: '场景' },
    { id: 'tag-tree-era',    label: '年代' },
    { id: 'tag-tree-gender', label: '受众频道' },
    { id: 'tag-tree-crowd',  label: '特定人群' },
    { id: 'tag-tree-custom', label: '自定义' }
  ];
  return dims.map(function(d){
    var container = document.getElementById(d.id);
    var children = container ? parseTreeChildren(container) : [];
    return { label: d.label, children: children };
  }).filter(function(n){ return n.children && n.children.length; });
}

// 初始化一个级联选择器
function initCascader(id, tree, opts) {
  opts = opts || {};
  var host = document.getElementById(id);
  if (!host) return;
  var multi = opts.multi !== false; // 默认多选
  host.classList.add('cascader');
  host.innerHTML = '';
  var placeholder = opts.placeholder || '请选择';

  var trigger = document.createElement('div');
  trigger.className = 'cascader-trigger' + (multi ? ' multi' : '');
  if (opts.minWidth) trigger.style.minWidth = opts.minWidth;
  trigger.innerHTML = '<span class="cascader-tags"><span class="cascader-text cascader-placeholder">' + placeholder + '</span></span><span class="cascader-caret">▼</span>';
  var panel = document.createElement('div');
  panel.className = 'cascader-panel';
  host.appendChild(trigger);
  host.appendChild(panel);

  // state.paths: 多选路径数组；state.path: 单选路径（兼容旧接口）
  var state = { tree: tree, multi: multi, path: [], paths: [], placeholder: placeholder, onSelect: opts.onSelect };
  host._cascader = state;

  function pathKey(p) { return p.join('·'); }
  function isChecked(p) {
    var k = pathKey(p);
    return state.paths.some(function(x){ return pathKey(x) === k; });
  }
  function togglePath(p) {
    var k = pathKey(p);
    var idx = -1;
    for (var i = 0; i < state.paths.length; i++) { if (pathKey(state.paths[i]) === k) { idx = i; break; } }
    if (idx >= 0) state.paths.splice(idx, 1);
    else state.paths.push(p.slice());
  }

  // 渲染面板的列（activePath 为当前展开路径）
  function renderColumns(activePath) {
    panel.innerHTML = '';
    var level = tree;
    for (var depth = 0; depth <= activePath.length; depth++) {
      if (!level || !level.length) break;
      var col = document.createElement('div');
      col.className = 'cascader-col';
      (function(levelNodes, depthIdx){
        levelNodes.forEach(function(node){
          var opt = document.createElement('div');
          opt.className = 'cascader-option';
          var isActive = activePath[depthIdx] === node.label;
          if (isActive) opt.classList.add('active');
          var hasChildren = node.children && node.children.length;
          var leafPath = activePath.slice(0, depthIdx).concat([node.label]);
          if (!hasChildren && multi && isChecked(leafPath)) opt.classList.add('checked');
          var checkHtml = (!hasChildren && multi) ? '<span class="opt-check">' + (isChecked(leafPath) ? '✓' : '') + '</span>' : '';
          opt.innerHTML = '<span style="display:flex; align-items:center; gap:6px;">' + checkHtml + '<span>' + node.label + '</span></span>' + (hasChildren ? '<span class="opt-arrow">▶</span>' : '');
          opt.onclick = function(e){
            e.stopPropagation();
            var newPath = activePath.slice(0, depthIdx);
            newPath.push(node.label);
            if (hasChildren) {
              renderColumns(newPath);
            } else if (multi) {
              // 多选叶子：切换选中，保持面板打开
              togglePath(newPath);
              updateTriggerText();
              renderColumns(newPath);
              if (typeof state.onSelect === 'function') state.onSelect(state.paths.map(function(p){ return p.slice(); }));
            } else {
              // 单选叶子：提交并关闭
              state.path = newPath;
              updateTriggerText();
              host.classList.remove('open');
              if (typeof state.onSelect === 'function') state.onSelect(newPath.slice());
            }
          };
          col.appendChild(opt);
        });
      })(level, depth);
      panel.appendChild(col);
      // 深入到下一列
      var chosen = null;
      for (var i = 0; i < level.length; i++) { if (level[i].label === activePath[depth]) { chosen = level[i]; break; } }
      level = chosen && chosen.children ? chosen.children : null;
    }
  }

  function updateTriggerText() {
    var tagsBox = trigger.querySelector('.cascader-tags');
    if (!tagsBox) return;
    tagsBox.innerHTML = '';
    if (multi) {
      if (!state.paths.length) {
        var ph = document.createElement('span');
        ph.className = 'cascader-text cascader-placeholder';
        ph.textContent = state.placeholder;
        tagsBox.appendChild(ph);
        return;
      }
      state.paths.forEach(function(p){
        var tag = document.createElement('span');
        tag.className = 'cascader-tag';
        var label = p[p.length - 1];
        tag.innerHTML = '<span>' + label + '</span><span class="tag-x">×</span>';
        tag.querySelector('.tag-x').onclick = function(e){
          e.stopPropagation();
          togglePath(p);
          updateTriggerText();
          if (host.classList.contains('open')) renderColumns(state.paths.length ? state.paths[state.paths.length-1] : []);
          if (typeof state.onSelect === 'function') state.onSelect(state.paths.map(function(x){ return x.slice(); }));
        };
        tagsBox.appendChild(tag);
      });
    } else {
      var txt = document.createElement('span');
      txt.className = 'cascader-text';
      if (state.path.length) { txt.textContent = state.path.join(' / '); }
      else { txt.textContent = state.placeholder; txt.classList.add('cascader-placeholder'); }
      tagsBox.appendChild(txt);
    }
  }

  state.refresh = function(){ updateTriggerText(); };

  trigger.onclick = function(e){
    e.stopPropagation();
    var isOpen = host.classList.contains('open');
    // 关闭其它已打开的级联
    document.querySelectorAll('.cascader.open').forEach(function(c){ if (c !== host) c.classList.remove('open'); });
    if (isOpen) { host.classList.remove('open'); }
    else { renderColumns(state.paths.length ? state.paths[state.paths.length-1] : []); host.classList.add('open'); }
  };

  renderColumns([]);
  updateTriggerText();
}

// 全局标签树缓存
var SEED_TAG_TREE_DATA = null;

// 读取级联当前选中路径（单选：返回路径数组；多选：返回最后一次选中的路径，兼容旧调用）
function getCascaderValue(id) {
  var host = document.getElementById(id);
  if (!host || !host._cascader) return [];
  var s = host._cascader;
  if (s.multi) return s.paths.length ? s.paths[s.paths.length-1].slice() : [];
  return s.path.slice();
}

// 读取多选级联的全部选中路径
function getCascaderValues(id) {
  var host = document.getElementById(id);
  if (!host || !host._cascader) return [];
  var s = host._cascader;
  return s.multi ? s.paths.map(function(p){ return p.slice(); }) : (s.path.length ? [s.path.slice()] : []);
}

// 清空级联选择
function clearCascader(id) {
  var host = document.getElementById(id);
  if (host && host._cascader) {
    host._cascader.path = [];
    host._cascader.paths = [];
    var tagsBox = host.querySelector('.cascader-tags');
    if (tagsBox) tagsBox.innerHTML = '<span class="cascader-text cascader-placeholder">' + host._cascader.placeholder + '</span>';
  }
}

// 外部回填多选级联的选中路径（编辑场景回填已选成员）
function setCascaderValues(id, paths) {
  var host = document.getElementById(id);
  if (!host || !host._cascader) return;
  host._cascader.paths = (paths || []).map(function(p){ return p.slice(); });
  if (typeof host._cascader.refresh === 'function') host._cascader.refresh();
}

// 点击空白处关闭所有级联面板
document.addEventListener('click', function(){
  document.querySelectorAll('.cascader.open').forEach(function(c){ c.classList.remove('open'); });
});

/* ===== 素材生产群组：群组增删改查 ===== */
var PERM_USER_POOL = ['沐雨晴', '林晓', '陈默', '苏珊', '王凯', '赵倩', '李拓', '周舟', '沈月', '韩江'];
var PERM_GROUPS = [
  { id: 'PG-01', name: '都市创意组1', admins: ['沐雨晴', '陈默'], users: ['林晓', '王凯', '赵倩'], created: '2026-03-12' },
  { id: 'PG-02', name: '甜宠创意组2', admins: ['苏珊'], users: ['周舟', '沈月', '韩江', '李拓'], created: '2026-04-02' },
  { id: 'PG-03', name: '古言创意组3', admins: ['王凯'], users: ['沐雨晴', '林晓'], created: '2026-05-18' },
  { id: 'PG-04', name: '投放运营组', admins: ['李拓'], users: ['陈默', '苏珊', '周舟'], created: '2026-06-09' }
];
var permEditingId = '';

// 查：按群组名称 / 管理员 / 用户关键词过滤并渲染列表
function renderPermGroups(kw) {
  kw = (kw || '').trim().toLowerCase();
  var tbody = document.getElementById('perm-tbody');
  var empty = document.getElementById('perm-empty');
  var cnt = document.getElementById('perm-count');
  if (!tbody) return;
  var items = PERM_GROUPS.filter(function (g) {
    if (!kw) return true;
    return g.name.toLowerCase().indexOf(kw) > -1
      || g.admins.some(function (a) { return a.toLowerCase().indexOf(kw) > -1; })
      || g.users.some(function (u) { return u.toLowerCase().indexOf(kw) > -1; });
  });
  if (cnt) cnt.textContent = PERM_GROUPS.length;
  if (!items.length) {
    tbody.innerHTML = '';
    if (empty) empty.style.display = 'block';
    return;
  }
  if (empty) empty.style.display = 'none';
  tbody.innerHTML = items.map(function (g) {
    return '<tr>'
      + '<td style="font-weight:500;">' + escHtml(g.name) + ' <span style="color:#94a3b8; font-size:11px;">' + g.id + '</span></td>'
      + '<td>' + g.admins.map(function (a) { return '<span class="pill pill-ai" style="margin:0 4px 4px 0;">' + escHtml(a) + '</span>'; }).join('') + '</td>'
      + '<td>' + g.users.map(function (u) { return '<span class="pill pill-manual" style="margin:0 4px 4px 0;">' + escHtml(u) + '</span>'; }).join('') + '</td>'
      + '<td style="color:#94a3b8;">' + g.created + '</td>'
      + '<td><button class="btn btn-outline" style="padding:3px 8px; font-size:11px;" onclick="openPermModal(\'' + escAttr(g.id) + '\')">编辑</button> '
      + '<button class="btn btn-outline" style="padding:3px 8px; font-size:11px; color:#ef4444; border-color:#fecaca;" onclick="deletePermGroup(\'' + escAttr(g.id) + '\')">删除</button></td>'
      + '</tr>';
  }).join('');
}

// 增/改：打开弹窗（带 id 为编辑并回填，不带为新增）
function openPermModal(id) {
  permEditingId = id || '';
  var g = null;
  for (var i = 0; i < PERM_GROUPS.length; i++) if (PERM_GROUPS[i].id === id) g = PERM_GROUPS[i];
  var t = document.getElementById('perm-modal-title');
  if (t) t.innerHTML = (g ? '编辑群组' : '新增群组') + ' <span style="font-size:12px; color:#94a3b8; font-weight:400;">— 配置群组名称、管理员与用户</span>';
  var inp = document.getElementById('perm-name-input');
  if (inp) inp.value = g ? g.name : '';
  setCascaderValues('perm-admin-cascader', (g ? g.admins : []).map(function (n) { return [n]; }));
  setCascaderValues('perm-user-cascader', (g ? g.users : []).map(function (n) { return [n]; }));
  showModal('perm-group-modal');
}

function savePermGroup() {
  var inp = document.getElementById('perm-name-input');
  var name = (inp ? inp.value : '').trim();
  var admins = getCascaderValues('perm-admin-cascader').map(function (p) { return p[p.length - 1]; });
  var users = getCascaderValues('perm-user-cascader').map(function (p) { return p[p.length - 1]; });
  if (!name) { alert('请输入群组名称'); return; }
  if (!admins.length) { alert('请至少选择一名群组管理员'); return; }
  if (permEditingId) {
    for (var i = 0; i < PERM_GROUPS.length; i++) {
      if (PERM_GROUPS[i].id === permEditingId) {
        PERM_GROUPS[i].name = name;
        PERM_GROUPS[i].admins = admins;
        PERM_GROUPS[i].users = users;
        break;
      }
    }
  } else {
    var dup = PERM_GROUPS.some(function (g) { return g.name === name; });
    if (dup) { alert('已存在同名群组，请更换名称'); return; }
    PERM_GROUPS.push({ id: 'PG-' + (10 + PERM_GROUPS.length), name: name, admins: admins, users: users, created: '2026-08-15' });
  }
  hideModal('perm-group-modal');
  var s = document.getElementById('perm-search');
  renderPermGroups(s ? s.value : '');
}

// 删：确认后移除群组
function deletePermGroup(id) {
  var g = null;
  for (var i = 0; i < PERM_GROUPS.length; i++) if (PERM_GROUPS[i].id === id) g = PERM_GROUPS[i];
  if (!confirm('确认删除群组「' + (g ? g.name : '') + '」？删除后群组成员将失去该群组的素材使用权限。')) return;
  PERM_GROUPS = PERM_GROUPS.filter(function (x) { return x.id !== id; });
  var s = document.getElementById('perm-search');
  renderPermGroups(s ? s.value : '');
}

renderPermGroups('');

