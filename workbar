}

/* 分镜参考内容植入 */
var currentShotRefTarget = { name: '', v: -1, i: -1 };
var shotRefPicked = [];

function getShot(name, v, i) {
  var g = SCRIPT_GROUPS[name];
  var ver = g && g.versions[v];
  return ver && ver.shots[i] ? ver.shots[i] : null;
}

function renderShotRefs(name, v, i) {
  var wrap = document.querySelector('.sp-ref[data-group="' + name + '"][data-ver="' + v + '"][data-shot="' + i + '"]');
  if (!wrap) return;
  var g = SCRIPT_GROUPS[name];
  var ver = g && g.versions[v];
  var s = getShot(name, v, i);
  var refs = (s && s.refs) || [];
  var editing = !!(ver && ver.editing);
  var esc = escAttr(name);
  var rows = refs.map(function (r, j) {
    var opts = REF_PURPOSES.map(function (p) {
      return '<option value="' + p + '"' + (r.purpose === p ? ' selected' : '') + '>' + p + '</option>';
    }).join('');
    var visual = (r.kind === 'asset')
      ? '<span class="sp-ref-asset" style="background:' + (r.bg || '#ede9fe') + ';">' + (r.emoji || '◆') + '</span>'
      : '<img src="' + r.src + '" alt="">';
    return '<div class="sp-ref-item">'
         + '<span class="sp-ref-thumb">'
         + visual
         + (editing ? '<button class="sp-ref-del" onclick="removeShotRef(\'' + esc + '\',' + v + ',' + i + ',' + j + ')">×</button>' : '')
         + '</span>'
         + '<span class="sp-ref-body">'
         + '<span class="sp-ref-from" title="' + escAttr(r.from || '本地上传') + '">' + (r.from || '本地上传') + '</span>'
         + '<select class="sp-ref-sel"' + (editing ? '' : ' disabled') + ' onchange="setShotRefPurpose(\'' + esc + '\',' + v + ',' + i + ',' + j + ',this.value)">' + opts + '</select>'
         + '</span>'
         + '</div>';
  }).join('');
  wrap.innerHTML = (rows ? '<div class="sp-ref-list">' + rows + '</div>' : '')
    + (editing ? '<button class="sp-ref-btn" onclick="openShotRefPicker(\'' + esc + '\',' + v + ',' + i + ')">' + (refs.length ? '+ 追加植入' : '+ 植入参考') + '</button>' : '')
    + (refs.length ? '<div class="sp-ref-hint">已植入 ' + refs.length + ' 张</div>'
                   : (editing ? '' : '<span style="font-size:11px; color:#cbd5e1;">未植入</span>'));
}

/* 打开选择弹窗：从操作对象已有参考内容中挑选 */
function openShotRefPicker(name, v, i) {
  currentShotRefTarget = { name: name, v: v, i: i };
  shotRefPicked = [];
  var s = getShot(name, v, i) || {};
  var t = document.getElementById('shot-ref-modal-target');
  if (t) t.textContent = '— ' + name + '脚本组 · 版本 ' + (v + 1) + ' · 分镜 ' + (i + 1) + '（' + (s.time || '') + '）';
  renderShotRefPool();
  updateShotRefPickCount();
  showModal('shot-ref-modal');
}

function refKey(r) { return (r && r.kind === 'asset') ? 'asset:' + r.aid : 'img:' + (r && r.src); }

function renderShotRefPool() {
  var pool = document.getElementById('shot-ref-pool');
  if (!pool) return;
  var owners = oldObjSelected.filter(function (n) { return (oldObjRefs[n] || []).length; });
  if (!owners.length) {
    pool.innerHTML = '<div style="padding:22px; text-align:center; font-size:12px; color:#94a3b8; border:1px dashed #e2e8f0; border-radius:8px;">'
      + '当前操作对象还没有参考内容，可先在「操作对象」中添加，或直接从本地上传 / 引用数据资产。</div>';
    return;
  }
  var cur = getShot(currentShotRefTarget.name, currentShotRefTarget.v, currentShotRefTarget.i);
  var used = ((cur && cur.refs) || []).map(refKey);
  pool.innerHTML = owners.map(function (name) {
    var items = (oldObjRefs[name] || []).map(function (r, idx) {
      var already = used.indexOf(refKey(r)) > -1;
      var visual = (r.kind === 'asset')
        ? '<div class="dap-thumb" style="background:' + (r.bg || '#ede9fe') + '; height:78px; margin-bottom:0;">' + (r.emoji || '◆') + '</div>'
        : '<img src="' + r.src + '" alt="">';
      return '<label class="sp-pool-item' + (already ? ' sp-pool-used' : '') + '">'
           + '<input type="checkbox" value="' + escAttr(name) + '|' + idx + '"' + (already ? ' disabled' : '') + ' onchange="toggleShotRefPick(this)">'
           + visual
           + '<span class="sp-pool-cap">' + (already ? '已植入' : (r.kind === 'asset' ? (r.aname || '数据资产') : r.purpose)) + '</span>'
           + '</label>';
    }).join('');
    return '<div class="sp-pool-group">'
         + '<div class="sp-pool-owner">' + name + ' <span>共 ' + (oldObjRefs[name] || []).length + ' 项</span></div>'
         + '<div class="sp-pool-grid">' + items + '</div>'
         + '</div>';
  }).join('');
}

function toggleShotRefPick(cb) {
  if (cb.checked) { if (shotRefPicked.indexOf(cb.value) < 0) shotRefPicked.push(cb.value); }
  else { shotRefPicked = shotRefPicked.filter(function (v) { return v !== cb.value; }); }
  updateShotRefPickCount();
}

function updateShotRefPickCount() {
  var c = document.getElementById('shot-ref-pick-count');
  if (c) c.textContent = '(' + shotRefPicked.length + ')';
}

function confirmShotRefPick() {
  var t = currentShotRefTarget;
  var s = getShot(t.name, t.v, t.i);
  if (!s) { hideModal('shot-ref-modal'); return; }
  if (!s.refs) s.refs = [];
  shotRefPicked.forEach(function (val) {
    var p = val.lastIndexOf('|');
    var name = val.slice(0, p);
    var idx = parseInt(val.slice(p + 1), 10);
    var r = (oldObjRefs[name] || [])[idx];
    if (!r) return;
    if (s.refs.some(function (x) { return refKey(x) === refKey(r); })) return;
    if (r.kind === 'asset') {
      s.refs.push({ kind: 'asset', aid: r.aid, aname: r.aname, emoji: r.emoji, bg: r.bg,
                    purpose: r.purpose || '自动判定', from: name });
    } else {
      s.refs.push({ src: r.src, purpose: r.purpose || '自动判定', fname: r.fname, from: name });
    }
  });
  shotRefPicked = [];
  renderShotRefs(t.name, t.v, t.i);
  hideModal('shot-ref-modal');
}

/* 本地上传补充 */
function triggerShotRefUpload(name, v, i) {
  if (typeof name === 'string' && typeof v === 'number' && typeof i === 'number') {
    currentShotRefTarget = { name: name, v: v, i: i };
  }
  var input = document.getElementById('shot-ref-input');
  if (input) { input.value = ''; input.click(); }
}

function handleShotRefUpload(input) {
  var t = currentShotRefTarget;
  var s = getShot(t.name, t.v, t.i);
  if (!s || !input.files || !input.files.length) return;
  if (!s.refs) s.refs = [];
  var files = Array.prototype.slice.call(input.files);
  var pending = files.length;
  files.forEach(function (f) {
    var reader = new FileReader();
    reader.onload = function (e) {
      s.refs.push({ src: e.target.result, purpose: '自动判定', fname: f.name, from: '本地上传' });
      pending--;
      if (pending === 0) { renderShotRefs(t.name, t.v, t.i); renderShotRefPool(); }
    };
    reader.readAsDataURL(f);
  });
}

function removeShotRef(name, v, i, j) {
  var s = getShot(name, v, i);
  if (!s || !s.refs) return;
  s.refs.splice(j, 1);
  renderShotRefs(name, v, i);
}

/* 单张参考图与参考用途一对一 */
function setShotRefPurpose(name, v, i, j, val) {
  var s = getShot(name, v, i);
  if (s && s.refs && s.refs[j]) s.refs[j].purpose = val;
}

function toggleScriptShot(name, v, i, checked) {
  var s = getShot(name, v, i);
  if (!s) return;
  s.picked = checked;
  var card = document.querySelector('.sg-card[data-group="' + name + '"] .sv-card[data-ver="' + v + '"]');
  if (!card) return;
  var tb = card.querySelector('tbody');
  if (tb && tb.rows[i]) tb.rows[i].className = checked ? 'sp-picked' : '';
  var stat = card.querySelector('span[style*="font-weight:600"]');
  var g = getScriptGroup(name);
  if (stat && g.versions[v]) stat.textContent = g.versions[v].shots.filter(function (x) { return x.picked; }).length;
}

function updateScriptShot(name, v, i, field, val) {
  var s = getShot(name, v, i);
  if (s) s[field] = (val || '').trim();
}

function removeScriptShot(name, v, i) {
  var g = getScriptGroup(name);
  var ver = g.versions[v];
  if (!ver) return;
  ver.shots.splice(i, 1);
  renderScriptVersions(name);
}

function addScriptShot(name, v) {
  var g = getScriptGroup(name);
  var ver = g.versions[v];
  if (!ver) return;
  ver.shots.push({ picked: false, time: '00:00-00:00', shot: '请填写画面描述', line: '请填写旁白 / 台词', refs: [] });
  renderScriptVersions(name);
}

