<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>素材裂变工作台</title>
<style>
* { box-sizing: border-box; }
body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f8fafc; margin: 0; }
.nav-link { display: flex; align-items: center; gap: 10px; padding: 9px 14px; border-radius: 8px; color: #475569; font-size: 14px; cursor: pointer; transition: all .15s; text-decoration: none; border-left: 3px solid transparent; }
.nav-link:hover { background: #f5f3ff; color: #334155; }
.nav-link.active { background: #ede9fe; color: #6d28d9; font-weight: 600; border-left: 3px solid #7c3aed; }
.nav-link .icon { width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; font-size: 15px; opacity: .85; }
.module { display: none; }
.module.active { display: block; }
.pill { display: inline-block; padding: 2px 8px; border-radius: 9999px; font-size: 12px; font-weight: 500; white-space: nowrap; }
.pill-genre { background: #ede9fe; color: #7c3aed; }
.pill-scene { background: #dbeafe; color: #2563eb; }
.pill-era { background: #fef3c7; color: #d97706; }
.pill-gender-m { background: #dbeafe; color: #1d4ed8; }
.pill-gender-f { background: #fce7f3; color: #db2777; }
.pill-crowd { background: #d1fae5; color: #059669; }
.pill-status-active { background: #d1fae5; color: #059669; }
.pill-status-paused { background: #fef3c7; color: #d97706; }
.pill-status-archived { background: #f1f5f9; color: #64748b; }
.pill-source { background: #e0e7ff; color: #4338ca; }
.pill-method { background: #fce7f3; color: #be185d; }
.pill-pending { background: #fef3c7; color: #92400e; }
.pill-approved { background: #d1fae5; color: #065f46; }
.pill-rejected { background: #fee2e2; color: #991b1b; }
.kpi-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; text-align: center; }
.kpi-card .value { font-size: 28px; font-weight: 700; color: #1e293b; }
.kpi-card .label { font-size: 13px; color: #64748b; margin-top: 4px; }
.kpi-card .sub { font-size: 11px; color: #94a3b8; margin-top: 6px; }
table { width: 100%; border-collapse: collapse; }
thead th { padding: 10px 12px; font-size: 12px; font-weight: 500; color: #64748b; text-align: left; background: #f8fafc; border-bottom: 1px solid #e2e8f0; white-space: nowrap; }
tbody td { padding: 12px; font-size: 13px; color: #334155; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
tbody tr:hover { background: #f8fafc; }
.thumb { width: 64px; height: 36px; border-radius: 4px; object-fit: cover; background: #e2e8f0; display: inline-block; }
.search-input { border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px 12px; font-size: 13px; width: 240px; outline: none; }
.search-input:focus { border-color: #a78bfa; box-shadow: 0 0 0 3px rgba(167,139,250,.1); }
.btn { padding: 7px 14px; border-radius: 8px; font-size: 13px; font-weight: 500; cursor: pointer; border: none; transition: all .15s; }
.btn-primary { background: #7c3aed; color: #fff; }
.btn-primary:hover { background: #6d28d9; }
.btn-outline { background: #fff; color: #64748b; border: 1px solid #e2e8f0; }
.btn-outline:hover { background: #f8fafc; border-color: #cbd5e1; }
.btn-success { background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; }
.btn-success:hover { background: #a7f3d0; }
.btn-warning { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
.btn-warning:hover { background: #fde68a; }
.filter-group { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.filter-pill { padding: 5px 12px; border-radius: 20px; font-size: 12px; background: #f1f5f9; color: #64748b; cursor: pointer; border: 1px solid transparent; transition: all .15s; }
.filter-pill:hover { background: #e2e8f0; }
.filter-pill.active { background: #ede9fe; color: #7c3aed; border-color: #c4b5fd; }
.filter-select { font-size: 12px; border: 1px solid #e2e8f0; border-radius: 8px; padding: 6px 10px; color: #334155; background: #fff; outline: none; }
.filter-select:focus { border-color: #c4b5fd; }
.filter-label { font-size: 12px; color: #94a3b8; white-space: nowrap; }
.filter-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.filter-row + .filter-row { margin-top: 12px; }
.pill-manual { background: #dbeafe; color: #1d4ed8; }
.pill-ai { background: #ede9fe; color: #7c3aed; }
.pill-public { background: #d1fae5; color: #059669; }
.pill-group { background: #fef3c7; color: #92400e; }
.tree-item { padding: 6px 12px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 13px; color: #334155; }
.tree-item:hover { background: #f1f5f9; }
.tree-item .arrow { color: #94a3b8; font-size: 10px; width: 16px; text-align: center; transition: transform .2s; }
.tree-item .arrow.expanded { transform: rotate(90deg); }
.tree-children { padding-left: 24px; }
.tree-badge { background: #f1f5f9; color: #64748b; font-size: 11px; padding: 1px 6px; border-radius: 10px; margin-left: auto; }
.tree-edit { color: #c4b5fd; font-size: 12px; cursor: pointer; opacity: 0; transition: opacity .15s, color .15s; }
.tree-edit:hover { color: #7c3aed; }
.tree-item:hover .tree-edit { opacity: 1; }
.tree-item.tree-active { background: #ede9fe; color: #6d28d9; font-weight: 600; box-shadow: inset 3px 0 0 #7c3aed; }
.tree-item.tree-active .tree-edit { opacity: 1; }
.card-section { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; margin-bottom: 16px; }
.card-section .section-title { font-size: 15px; font-weight: 600; color: #1e293b; margin-bottom: 16px; display: flex; align-items: center; justify-content: space-between; }
.tab-bar { display: flex; gap: 2px; background: #f1f5f9; border-radius: 8px; padding: 3px; width: fit-content; margin-bottom: 16px; }
.tab-item { padding: 6px 14px; border-radius: 6px; font-size: 13px; color: #64748b; cursor: pointer; transition: all .15s; }
.tab-item.active { background: #fff; color: #1e293b; font-weight: 500; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
.flow-step { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0; }
.flow-step .step-num { width: 24px; height: 24px; border-radius: 50%; background: #7c3aed; color: #fff; font-size: 12px; font-weight: 600; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.flow-arrow { color: #cbd5e1; font-size: 18px; text-align: center; padding: 4px 0; }
.checkbox { width: 16px; height: 16px; border-radius: 4px; border: 1.5px solid #cbd5e1; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
.checkbox.checked { background: #7c3aed; border-color: #7c3aed; }
.checkbox.checked::after { content: '✓'; color: #fff; font-size: 10px; }
.seed-link { color: #7c3aed; text-decoration: none; font-size: 12px; }
.seed-link:hover { text-decoration: underline; }
.progress-bar { height: 4px; background: #e2e8f0; border-radius: 2px; overflow: hidden; width: 60px; display: inline-block; vertical-align: middle; }
.progress-bar .fill { height: 100%; border-radius: 2px; }
.sidebar-divider { height: 1px; background: #e2e8f0; margin: 12px 0; }
.count-badge { font-size: 11px; color: #94a3b8; margin-left: auto; background: #f1f5f9; padding: 2px 7px; border-radius: 10px; }
/* Modal */
.modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 9999; align-items: center; justify-content: center; }
.modal-overlay.show { display: flex; }
.modal-card { background: #fff; border-radius: 16px; padding: 24px; width: 520px; max-height: 80vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,.15); }
.modal-card h3 { font-size: 16px; font-weight: 600; color: #1e293b; margin: 0 0 16px; }
/* 老素材裂变 — 操作对象下拉筛选 */
.oldobj-opt label { display: flex; align-items: center; gap: 10px; padding: 8px 12px; cursor: pointer; }
.oldobj-opt label:hover { background: #faf9ff; }
.oldobj-opt input[type="checkbox"] { accent-color: #7c3aed; width: 14px; height: 14px; flex-shrink: 0; }
.oo-thumb { width: 34px; height: 46px; border-radius: 4px; flex-shrink: 0; }
.oo-video { position: relative; width: 187px; height: 332px; flex-shrink: 0; border-radius: 8px; overflow: hidden; background: #0f172a; }
.oo-video-poster { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; cursor: pointer; }
.oo-video-poster .oo-video-play { width: 40px; height: 40px; border-radius: 50%; background: rgba(15,23,42,.45); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 14px; padding-left: 3px; box-sizing: border-box; transition: background .15s; }
.oo-video-poster:hover .oo-video-play { background: rgba(124,58,237,.85); }
.oo-video-sim { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.oo-video-sim-ico { color: #fff; font-size: 15px; letter-spacing: 2px; text-shadow: 0 1px 4px rgba(0,0,0,.45); }
.oo-clipbtn[disabled] { color: #94a3b8; border-color: #e2e8f0; background: #f8fafc; cursor: not-allowed; }
.req-box { border: 1px solid #e2e8f0; border-radius: 6px; background: #fff; padding: 8px; }
.req-box:focus-within { border-color: #c4b5fd; }
.req-thumbs { display: flex; gap: 6px; flex-wrap: wrap; }
.req-thumbs:not(:empty) { margin-bottom: 6px; }
.req-thumb-chip { width: 34px; height: 34px; border-radius: 5px; overflow: hidden; cursor: pointer; border: 1px solid #c4b5fd; padding: 0; background: #ede9fe; }
.req-thumb-chip:hover { border-color: #dc2626; }
.req-thumb-chip img { width: 100%; height: 100%; object-fit: cover; display: block; }
.req-thumb-chip .chip-emoji { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 15px; }
.req-textarea { border: none; outline: none; width: 100%; min-height: 52px; resize: vertical; font-family: inherit; font-size: 13px; color: #334155; background: transparent; box-sizing: border-box; }
.ref-thumb { cursor: pointer; }
.ref-thumb.ref-picked img, .ref-thumb.ref-picked .ref-asset { outline: 2px solid #7c3aed; outline-offset: 1px; }
.pack-item { display: flex; align-items: center; gap: 8px; padding: 11px 14px; border: 1px solid #e2e8f0; border-radius: 8px; background: #fff; cursor: pointer; transition: border-color .15s; min-width: 0; }
.pack-item:hover { border-color: #c4b5fd; }
.pack-item .pack-dot { width: 7px; height: 7px; border-radius: 50%; background: #22c55e; flex-shrink: 0; }
.pack-item.off .pack-dot { background: #cbd5e1; }
.pack-item .pack-ico { color: #1890ff; font-size: 14px; flex-shrink: 0; }
.pack-item .pack-name { font-size: 13px; font-weight: 600; color: #1e293b; white-space: nowrap; }
.pack-item.off .pack-name { color: #94a3b8; font-weight: 500; }
.pack-item .pack-desc { font-size: 12px; color: #94a3b8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.ctrl-row { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 12px; }
.ctrl-row:last-child { margin-bottom: 2px; }
.ctrl-row .ctrl-label { width: 108px; flex-shrink: 0; }
.ctrl-row .ctrl-label b { display: block; font-size: 12px; color: #334155; font-weight: 600; }
.ctrl-row .ctrl-label span { display: block; font-size: 10.5px; color: #94a3b8; margin-top: 3px; line-height: 1.5; }
.ctrl-opts { flex: 1; display: flex; gap: 8px; flex-wrap: wrap; }
.ctrl-pill { padding: 5px 12px; font-size: 12px; color: #475569; background: #fff; border: 1px solid #e2e8f0; border-radius: 6px; cursor: pointer; }
.ctrl-pill:hover { border-color: #c4b5fd; color: #6d28d9; }
.ctrl-pill.active { color: #6d28d9; background: #f5f3ff; border-color: #7c3aed; }
.rate-pill { padding: 4px 10px; font-size: 11px; color: #475569; background: #fff; border: 1px solid #e2e8f0; border-radius: 5px; cursor: pointer; }
.rate-pill:hover { border-color: #c4b5fd; }
.rate-pill.active { color: #fff; background: #7c3aed; border-color: #7c3aed; }
.oo-video-sim-bar { position: absolute; left: 8px; right: 8px; bottom: 6px; height: 3px; border-radius: 2px; background: rgba(255,255,255,.35); overflow: hidden; }
.oo-video-sim-bar i { display: block; height: 100%; width: 40%; background: #fff; animation: ooVideoProg 6s linear infinite; }
@keyframes ooVideoProg { from { margin-left: -40%; } to { margin-left: 100%; } }
.oo-video-stop { position: absolute; top: 4px; right: 4px; width: 18px; height: 18px; line-height: 18px; text-align: center; font-size: 9px; color: #fff; background: rgba(15,23,42,.55); border: none; border-radius: 50%; cursor: pointer; padding: 0; z-index: 2; }
.oo-video-stop:hover { background: #dc2626; }
.oo-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.oo-name { font-size: 13px; color: #1e293b; font-weight: 500; }
.oo-meta { font-size: 11px; color: #94a3b8; }
.oldobj-row { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border: 1px solid #ede9fe; background: #faf9ff; border-radius: 8px; margin-bottom: 8px; }
.oldobj-row .oo-main { flex: 1; }
.oldobj-row .oo-remove { font-size: 12px; color: #94a3b8; cursor: pointer; border: 1px solid #e2e8f0; background: #fff; border-radius: 6px; padding: 3px 9px; }
.oldobj-row .oo-remove:hover { color: #dc2626; border-color: #fecaca; }
/* 操作对象成组卡片：素材文件 + 前贴截取范围 + 参考内容 */
.oldobj-group { border: 1px solid #ede9fe; background: #faf9ff; border-radius: 10px; padding: 12px 14px; margin-bottom: 12px; }
.oldobj-sub { margin-top: 12px; padding-top: 12px; border-top: 1px dashed #e2e8f0; }
.oldobj-sub-title { font-size: 12px; color: #64748b; font-weight: 500; margin-bottom: 10px; }
.oldobj-sub-title span { color: #94a3b8; font-weight: 400; }
.oo-flabel { display: block; font-size: 12px; color: #64748b; margin-bottom: 6px; }
.oo-finput { width: 100%; padding: 7px 10px; font-size: 13px; border: 1px solid #e2e8f0; border-radius: 6px; outline: none; background: #fff; }
.oo-finput:focus { border-color: #c4b5fd; }
.oo-fhint { font-size: 11px; color: #94a3b8; margin-top: 5px; }
.oo-fselect { padding: 6px 8px; font-size: 12px; border: 1px solid #e2e8f0; border-radius: 6px; color: #475569; background: #fff; outline: none; }
/* 参考内容：卡片内最左侧操作列 */
.ref-block { display: flex; gap: 14px; align-items: flex-start; }
.ref-ctrl { width: 136px; flex-shrink: 0; display: flex; flex-direction: column; gap: 7px; }
.ref-ctrl .oo-fselect { width: 100%; }
.ref-ctrl .ref-add-btn { width: 100%; padding: 6px 8px; font-size: 12px; color: #7c3aed; background: #fff; border: 1px solid #c4b5fd; border-radius: 6px; cursor: pointer; }
.ref-ctrl .ref-add-btn:hover { background: #f5f3ff; }
.ref-ctrl .ref-ctrl-hint { font-size: 10.5px; color: #cbd5e1; line-height: 1.55; }
.ref-images { flex: 1; min-width: 0; display: flex; gap: 10px; flex-wrap: wrap; }
.ref-asset { position: relative; width: 92px; height: 92px; border-radius: 6px; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; font-size: 30px; overflow: hidden; }
.ref-asset-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 2px 4px; font-size: 10px; color: #fff; background: rgba(15,23,42,.45); border-radius: 0 0 6px 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ref-thumb { position: relative; width: 92px; }
.ref-thumb img { width: 92px; height: 92px; object-fit: cover; border-radius: 6px; border: 1px solid #e2e8f0; display: block; background: #f1f5f9; }
.ref-thumb .ref-del { position: absolute; top: -6px; right: -6px; width: 18px; height: 18px; line-height: 16px; text-align: center; font-size: 12px; color: #fff; background: #94a3b8; border: none; border-radius: 50%; cursor: pointer; padding: 0; }
.ref-thumb .ref-del:hover { background: #dc2626; }
.ref-purpose-sel { width: 92px; margin-top: 5px; padding: 3px 4px; font-size: 11px; border: 1px solid #e2e8f0; border-radius: 5px; color: #475569; background: #fff; outline: none; }
/* Excel 批量导入操作对象 */
.oo-src-tip { font-size: 11px; color: #94a3b8; margin-top: 8px; }
.xls-steps .filter-pill { cursor: default; }
.xls-steps .filter-pill:hover { background: #f1f5f9; }
.xls-steps .filter-pill.active:hover { background: #ede9fe; }
.xls-drop { border: 2px dashed #c4b5fd; border-radius: 10px; padding: 26px 18px; text-align: center; background: #faf9ff; cursor: pointer; }
.xls-drop:hover { background: #f5f3ff; border-color: #a78bfa; }
.xls-drop .xls-ico { font-size: 22px; color: #7c3aed; margin-bottom: 6px; }
.xls-drop .xls-main { font-size: 13px; color: #475569; }
.xls-drop .xls-sub { font-size: 11px; color: #94a3b8; margin-top: 5px; }
.xls-file { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border: 1px solid #ede9fe; background: #faf9ff; border-radius: 8px; font-size: 12px; color: #475569; }
.xls-file .xls-name { flex: 1; font-weight: 500; color: #1e293b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.xls-file .xls-reset { font-size: 11px; color: #94a3b8; border: 1px solid #e2e8f0; background: #fff; border-radius: 5px; padding: 3px 9px; cursor: pointer; }
.xls-file .xls-reset:hover { color: #7c3aed; border-color: #c4b5fd; }
.xls-tpl { border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; }
.xls-tpl table { width: 100%; border-collapse: collapse; font-size: 11px; }
.xls-tpl th { background: #f8fafc; color: #64748b; font-weight: 500; text-align: left; padding: 7px 9px; border-bottom: 1px solid #e2e8f0; white-space: nowrap; }
.xls-tpl td { padding: 6px 9px; border-bottom: 1px solid #f1f5f9; color: #475569; }
.xls-tpl tbody tr:last-child td { border-bottom: none; }
.xls-tpl .xls-req { color: #dc2626; margin-left: 2px; }
.xls-prev { border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; max-height: 260px; overflow-y: auto; }
.xls-prev table { width: 100%; border-collapse: collapse; font-size: 11.5px; }
.xls-prev th { position: sticky; top: 0; background: #f8fafc; color: #64748b; font-weight: 500; text-align: left; padding: 7px 9px; border-bottom: 1px solid #e2e8f0; white-space: nowrap; z-index: 1; }
.xls-prev td { padding: 7px 9px; border-bottom: 1px solid #f1f5f9; color: #334155; vertical-align: middle; }
.xls-prev tbody tr:last-child td { border-bottom: none; }
.xls-prev tr.xls-bad td { background: #fef2f2; color: #991b1b; }
.xls-prev input[type="checkbox"] { accent-color: #7c3aed; width: 14px; height: 14px; }
.xls-prev input[type="checkbox"]:disabled { opacity: .45; cursor: not-allowed; }
.xls-prev .xls-mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; color: #6d28d9; }
.xls-badge { display: inline-block; padding: 1px 7px; font-size: 10.5px; border-radius: 10px; white-space: nowrap; }
.xls-badge.ok { color: #16a34a; background: #dcfce7; }
.xls-badge.bad { color: #dc2626; background: #fee2e2; }
.xls-badge.local { color: #1d4ed8; background: #dbeafe; }
.xls-badge.seed { color: #6d28d9; background: #ede9fe; }
.xls-badge.copy { color: #b45309; background: #fef3c7; }
.xls-badge.task { color: #0f766e; background: #ccfbf1; }
.xls-badge.mass { color: #be185d; background: #fce7f3; }
.copy-preview { padding: 10px 12px; font-size: 12.5px; line-height: 1.7; color: #92400e; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; }
#oldobj-empty.oo-dragover { border-color: #7c3aed !important; border-style: solid !important; background: #f5f3ff !important; }
#oldobj-empty.oo-dragover .oo-src-tip { color: #7c3aed; }
.xls-stat { display: flex; align-items: center; gap: 14px; font-size: 12px; color: #64748b; padding: 9px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; }
.xls-stat b { color: #7c3aed; }
.xls-stat .xls-stat-bad b { color: #dc2626; }
/* 数据资产选择弹窗 */
.dap-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
.dap-search { width: 100%; padding: 8px 10px; font-size: 13px; border: 1px solid #e2e8f0; border-radius: 6px; outline: none; margin-bottom: 12px; }
.dap-search:focus { border-color: #c4b5fd; }
.dap-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; max-height: 340px; overflow-y: auto; padding: 2px; }
