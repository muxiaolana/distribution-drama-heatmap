// 操作对象视频：点击在页面内播放（本地上传播放原文件，其余素材模拟播放）
function playOldObjVideo(wrap, name) {
  if (!wrap) return;
  var ext = oldObjExtra[name] || {};
  var poster = wrap.querySelector('.oo-video-poster');
  var bg = poster ? (poster.style.background || '') : '';
  var esc = escAttr(name);
  var inner = '';
  if (ext.url) {
    inner = '<video src="' + ext.url + '" controls autoplay style="width:100%; height:100%; display:block; object-fit:cover; background:#0f172a;"></video>';
  } else {
    inner = '<div class="oo-video-sim" style="background:' + (bg || 'linear-gradient(135deg,#c084fc,#7c3aed)') + ';">'
      + '<span class="oo-video-sim-ico">❚❚ 播放中</span>'
      + '<span class="oo-video-sim-bar"><i></i></span></div>';
  }
  wrap.innerHTML = inner + '<button class="oo-video-stop" title="停止播放" onclick="stopOldObjVideo(this.parentNode,\'' + esc + '\')">■</button>';
  oldObjPlay[name] = { t0: Date.now(), acc: 0 };
  var rate = oldObjRate[name] || 1;
  var vv = wrap.querySelector('video');
  if (vv) vv.playbackRate = rate;
  var barI = wrap.querySelector('.oo-video-sim-bar i');
  if (barI) barI.style.animationDuration = (6 / rate) + 's';
  (wrap.closest('.oo-headrow') || wrap.parentNode).querySelectorAll('.oo-clipbtn').forEach(function (b) { b.disabled = false; });
}
function stopOldObjVideo(wrap, name) {
  if (!wrap) return;
  var vid = wrap.querySelector('video');
  if (vid) { try { vid.pause(); } catch (e) {} }
  var bg = '';
  var sim = wrap.querySelector('.oo-video-sim');
  if (sim) bg = sim.style.background || '';
  if (!bg) {
    var t = document.querySelector('#oldobj-options .oldobj-opt[data-name="' + name + '"] .oo-thumb');
    if (t) bg = t.style.background;
    var ext = oldObjExtra[name];
    if (!bg && ext && ext.bg) bg = ext.bg;
  }
  var esc = escAttr(name);
  wrap.innerHTML = '<div class="oo-video-poster" style="background:' + (bg || 'linear-gradient(135deg,#c084fc,#7c3aed)') + ';" onclick="playOldObjVideo(this.parentNode,\'' + esc + '\')"><span class="oo-video-play">▶</span></div>';
  delete oldObjPlay[name];
  (wrap.closest('.oo-headrow') || wrap.parentNode).querySelectorAll('.oo-clipbtn').forEach(function (b) { b.disabled = true; });
}

// 播放速度调整（真实video用playbackRate，模拟播放按速率累计时间）
function getSimTime(name) {
  var st = oldObjPlay[name];
  if (!st) return 0;
  return (st.acc || 0) + (Date.now() - st.t0) / 1000 * (oldObjRate[name] || 1);
}
function setOldObjRate(name, rate, btn) {
  oldObjRate[name] = rate;
  if (oldObjPlay[name]) {
    oldObjPlay[name].acc = getSimTime(name);
    oldObjPlay[name].t0 = Date.now();
  }
  var wrap = document.querySelector('#oldobj-list .oo-video[data-owner="' + escAttr(name) + '"]');
  if (wrap) {
    var vid = wrap.querySelector('video');
    if (vid) vid.playbackRate = rate;
    var barI = wrap.querySelector('.oo-video-sim-bar i');
    if (barI) barI.style.animationDuration = (6 / rate) + 's';
  }
  if (btn) {
    btn.parentElement.querySelectorAll('.rate-pill').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
  }
}

// 将当前播放位置写入前贴截取范围（start/end）
function setClipFromPlay(name, which, btn) {
  var wrap = document.querySelector('#oldobj-list .oo-video[data-owner="' + escAttr(name) + '"]');
  if (!wrap) return;
  var t = null;
  var vid = wrap.querySelector('video');
  if (vid) { t = vid.currentTime || 0; }
  else if (oldObjPlay[name]) { t = getSimTime(name); }
  if (t === null || t === undefined) return;
  var clip = oldObjClip[name] || (oldObjClip[name] = { start: '00:00.000', end: '00:15.000' });
  var txt = fmtClockMs(t);
  if (which === 'start') { clip.start = txt; } else { clip.end = txt; }
  var group = btn ? btn.closest('.oldobj-group') : null;
  if (group) {
    var inp = group.querySelector('[data-clipinput="' + which + '"]');
    if (inp) inp.value = txt;
  }
}

