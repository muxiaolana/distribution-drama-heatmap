function handleRefUpload(input) {
  var name = currentRefTarget;
  if (!name || !input.files || !input.files.length) return;
  if (!oldObjRefs[name]) oldObjRefs[name] = [];
  var files = Array.prototype.slice.call(input.files);
  var pending = files.length;
  files.forEach(function (f) {
    var reader = new FileReader();
    reader.onload = function (e) {
      oldObjRefs[name].push({ src: e.target.result, purpose: '自动判定', fname: f.name });
      pending--;
      if (pending === 0) renderRefImages(name);
    };
    reader.readAsDataURL(f);
  });
}

