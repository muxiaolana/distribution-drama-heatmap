  var row = null;
  CTRL_ROWS.forEach(function (r) { if (r.key === key) row = r; });
  var token = row ? ctrlToken(row.label, opt) : opt;
  var group = btn ? btn.closest('.oldobj-group') : null;
  var ta = group ? group.querySelector('.req-textarea') : null;
  if (pos >= 0) {
    arr.splice(pos, 1);
    if (ta) { ta.value = ta.value.split(token).join(''); oldObjReq[name] = ta.value; }
    btn.classList.remove('active');
    btn.textContent = '+ ' + opt;
  } else {
    arr.push(opt);
    if (ta) {
      var p = ta.selectionStart || ta.value.length;
      ta.value = ta.value.slice(0, p) + token + ta.value.slice(p);
      ta.selectionStart = ta.selectionEnd = p + token.length;
      oldObjReq[name] = ta.value;
