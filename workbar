function showAssetDetail(id) {
  var a = ASSET_DATA[id];
  if (!a || !TPL[a.type]) return;
  var typeName = { person:'人物', scene:'场景', costume:'服饰', prop:'道具', style:'风格' }[a.type];
  var catBadge = a.cat ? '<span class="attr-badge">' + a.cat + '</span> ' : '';
  var titleEl = document.getElementById('asset-detail-title');
  titleEl.innerHTML =
    '<div style="display:flex; align-items:center; gap:12px;">' +
      '<div style="width:44px; height:44px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:22px; background:' + a.grad + ';">' + a.icon + '</div>' +
      '<div>' +
        '<h3 style="margin:0;">' + a.title + '</h3>' +
        '<div style="font-size:12px; color:#94a3b8; margin-top:2px;"><span class="attr-badge">' + typeName + '资产</span> ' + catBadge + a.code + '</div>' +
      '</div>' +
    '</div>';
  var layers = TPL[a.type](a);
  var html = '';
  layers.forEach(function(layer){
    html += '<div class="detail-layer">';
    html += '<div class="detail-layer-head"><span class="dl-dot"></span>' + layer.name + '</div>';
    layer.groups.forEach(function(g){
      html += '<div class="detail-group"><div class="dg-title">' + g.title + '</div>';
      g.attrs.forEach(function(at){
        html += '<div class="attr-row"><div class="attr-k">' + at[0] + '</div><div class="attr-v">' + at[1] + '</div></div>';
      });
      html += '</div>';
    });
    html += '</div>';
  });
  document.getElementById('asset-detail-body').innerHTML = html;
  showModal('asset-detail-modal');
}

// 树形展开/折叠
function toggleTree(el) {
  const arrow = el.querySelector('.arrow');
  const children = el.nextElementSibling;
  if (!children || !children.classList.contains('tree-children')) return;
  if (children.style.display === 'none') {
    children.style.display = 'block';
    if (arrow) arrow.classList.add('expanded');
  } else {
    children.style.display = 'none';
    if (arrow) arrow.classList.remove('expanded');
  }
}

// 标签维度切换
function switchTagTab(el, dim) {
  el.parentElement.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  // 切换树：隐藏全部，显示当前维度
  ['genre','scene','era','gender','crowd','media','custom'].forEach(function(d){
    var tree = document.getElementById('tag-tree-' + d);
    if (tree) tree.style.display = (d === dim) ? 'block' : 'none';
  });
}

// 新增标签：所属维度切换（选择"新建维度"时显示输入框，并禁用父级）
function onTagDimChange(sel) {
  var isNew = sel.value === '__new__';
  var newBlock = document.getElementById('tag-add-newdim');
  var parent = document.getElementById('tag-add-parent');
  if (newBlock) newBlock.style.display = isNew ? 'block' : 'none';
  if (parent) {
    parent.disabled = isNew;
    parent.style.opacity = isNew ? '.5' : '1';
    if (isNew) parent.value = '';
  }
}

