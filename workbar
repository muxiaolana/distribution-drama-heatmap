function handlePlVideoPick(input) {
  if (!input.files || !input.files.length) return;
  var files = Array.prototype.slice.call(input.files);
  files.forEach(function (f, k) {
    var url = '';
    try { url = (window.URL || window.webkitURL).createObjectURL(f); } catch (e) { url = ''; }
    var item = {
      source: 'local', name: f.name.replace(/\.[^.]+$/, ''), url: url,
      meta: f.name + ' · ' + (f.size / 1024 / 1024).toFixed(1) + ' MB',
      bg: LOCAL_BG[(plVideos.length + k) % LOCAL_BG.length]
    };
    plVideos.push(item);
    if (!url) return;
    var v = document.createElement('video');
    v.preload = 'metadata';
    v.onloadedmetadata = function () {
      if (isFinite(v.duration) && v.duration > 0) {
        item.meta += ' · 时长 ' + fmtClock(v.duration);
        renderPlVideos();
      }
    };
    v.src = url;
  });
  renderPlVideos();
  hideModal('pl-add-modal');
  alert('已添加 ' + files.length + ' 条本地视频作为后链路拼接内容。');
}

