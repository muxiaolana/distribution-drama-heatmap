  costume:['全部','古代','现代'],
  prop:   ['全部','古代','现代'],
  style:  []
};

function renderSubcatBar(type) {
  var bar = document.getElementById('asset-subcat-bar');
  if (!bar) return;
  var cats = ASSET_SUBCATS[type] || [];
  if (cats.length === 0) { bar.style.display = 'none'; return; }
  bar.style.display = 'flex';
  var html = '<span class="filter-label" style="margin-right:2px;">细分：</span>';
  cats.forEach(function(c, i){
    html += '<span class="filter-pill' + (i === 0 ? ' active' : '') + '" onclick="filterAssetCat(this,\'' + c + '\')">' + c + '</span>';
  });
  bar.innerHTML = html;
}

function switchAssetType(el, type) {
  el.parentElement.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  ASSET_CUR_TYPE = type;
  ['person','scene','costume','prop','style'].forEach(function(t){
    var p = document.getElementById('asset-panel-' + t);
    if (p) p.style.display = (t === type) ? 'block' : 'none';
  });
  renderSubcatBar(type);
}

// 二级分类筛选：按 data-cat 过滤当前面板卡片
function filterAssetCat(el, cat) {
  if (el && el.parentElement) {
    el.parentElement.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
    el.classList.add('active');
  }
  var panel = document.getElementById('asset-panel-' + ASSET_CUR_TYPE);
  if (!panel) return;
  panel.querySelectorAll('.asset-card').forEach(function(card){
    var cats = (card.getAttribute('data-cat') || '').split(/\s+/);
    var show = (cat === '全部') || cats.indexOf(cat) !== -1;
    card.style.display = show ? 'flex' : 'none';
  });
}

