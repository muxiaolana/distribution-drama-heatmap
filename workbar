function filterObjOptionList(listSel, noresId, fId, fInc, fExc, genre, task, fDrama) {
  var opts = document.querySelectorAll(listSel + ' .oldobj-opt');
  var visible = 0;
  opts.forEach(function (o) {
    var id = (o.getAttribute('data-id') || '').toLowerCase();
    var name = (o.getAttribute('data-name') || '').toLowerCase();
    var okId = !fId || id.indexOf(fId) > -1;
    var okInc = !fInc || name.indexOf(fInc) > -1;
    var okExc = !fExc || name.indexOf(fExc) < 0;
    var okGenre = !genre || o.getAttribute('data-genre') === genre;
    var okTask = !task || o.getAttribute('data-task') === task;
    var okDrama = !fDrama || (o.getAttribute('data-drama') || '').toLowerCase().indexOf(fDrama) > -1;
    var show = okId && okInc && okExc && okGenre && okTask && okDrama;
    o.style.display = show ? 'block' : 'none';
    if (show) visible++;
  });
  var nores = document.getElementById(noresId);
  if (nores) nores.style.display = visible ? 'none' : 'block';
}

function confirmOldObjPick() {
  var picked = [];
  ['oldobj-options', 'copyobj-options', 'taskclip-options', 'massclip-options'].forEach(function (id) {
    document.querySelectorAll('#' + id + ' .oldobj-opt input[type="checkbox"]').forEach(function (cb) {
      if (cb.checked) picked.push(cb.value);
    });
  });
  // 脚本文案 / 任务片段 / 量产片段 记录来源补充信息
  picked.forEach(function (n) {
    var c = findCopyByName(n);
    if (c) {
      oldObjExtra[n] = { source: 'copy', id: c.id, work: c.work, genre: c.genre, tag: c.tag, text: c.text, bg: c.bg };
      return;
    }
    var tc = findTaskClipByName(n);
    if (tc) {
      oldObjExtra[n] = { source: 'taskclip', id: tc.id, task: taskNameById(tc.task), work: tc.work, genre: tc.genre, dur: tc.dur, method: tc.method, bg: tc.bg };
      return;
    }
    var mc = findMassClipByName(n);
    if (mc) {
      oldObjExtra[n] = { source: 'massclip', id: mc.id, work: mc.work, genre: mc.genre, dur: mc.dur, bg: mc.bg };
    }
  });
  // 本地上传 / Excel 导入的对象不在下拉框内，需保留
  var imported = oldObjSelected.filter(function (n) {
    var e = oldObjExtra[n];
    return !!e && (e.source === 'local' || e.source === 'excel');
  });
  oldObjSelected = imported.concat(picked.filter(function (n) { return imported.indexOf(n) < 0; }));
  renderOldObjList();
  closeOldObjPicker();
}

function removeOldObj(name) {
  oldObjSelected = oldObjSelected.filter(function (n) { return n !== name; });
  var ext = oldObjExtra[name];
  if (ext && ext.source === 'local' && ext.url) {
    try { (window.URL || window.webkitURL).revokeObjectURL(ext.url); } catch (e) {}
  }
  delete oldObjRefs[name];
  delete oldObjClip[name];
  delete oldObjReq[name];
  delete oldObjExtra[name];
  renderOldObjList();
}

