/* 目标已引用的资产（用于置灰） */
function assetPickUsedIds() {
  var list = [];
  if (assetPickTarget.mode === 'obj') list = oldObjRefs[assetPickTarget.name] || [];
  else {
    var s = getShot(currentShotRefTarget.name, currentShotRefTarget.v, currentShotRefTarget.i);
    list = (s && s.refs) || [];
  }
  return list.filter(function (r) { return r.kind === 'asset'; }).map(function (r) { return r.aid; });
}

function renderAssetPickGrid() {
  var grid = document.getElementById('asset-pick-grid');
  if (!grid) return;
  var kwEl = document.getElementById('asset-pick-search');
  var kw = (kwEl ? kwEl.value : '').trim().toLowerCase();
  var used = assetPickUsedIds();
  var rows = (ASSET_LIB[assetPickType] || []).filter(function (a) {
    if (!kw) return true;
    return (a.name + ' ' + a.id + ' ' + a.meta).toLowerCase().indexOf(kw) > -1;
  });
  if (!rows.length) {
    grid.innerHTML = '<div class="dap-empty">未匹配到资产，换个关键词或切换资产类型</div>';
    return;
  }
  grid.innerHTML = rows.map(function (a) {
    var val = assetPickType + '|' + a.id;
    var on = assetPicked.indexOf(val) > -1;
    var dis = used.indexOf(a.id) > -1;
    return '<label class="dap-item' + (on ? ' dap-on' : '') + (dis ? ' sp-pool-used' : '') + '" data-val="' + val + '">'
         + '<input type="checkbox" value="' + val + '"' + (on ? ' checked' : '') + (dis ? ' disabled' : '') + ' onchange="toggleAssetPick(this)">'
         + '<div class="dap-thumb" style="background:' + a.bg + ';">' + a.emoji + '</div>'
         + '<div class="dap-name">' + a.name + '</div>'
         + '<div class="dap-meta">' + a.id + ' · ' + (dis ? '已引用' : a.meta) + '</div>'
         + '</label>';
  }).join('');
}

function toggleAssetPick(cb) {
  if (cb.checked) { if (assetPicked.indexOf(cb.value) < 0) assetPicked.push(cb.value); }
  else { assetPicked = assetPicked.filter(function (v) { return v !== cb.value; }); }
  var item = cb.closest ? cb.closest('.dap-item') : null;
  if (item) item.classList.toggle('dap-on', cb.checked);
  updateAssetPickCount();
}

function updateAssetPickCount() {
  var c = document.getElementById('asset-pick-count');
  if (c) c.textContent = '(' + assetPicked.length + ')';
}

function confirmAssetPick() {
  if (!assetPicked.length) { hideModal('asset-pick-modal'); return; }
  var made = assetPicked.map(function (val) {
    var p = val.indexOf('|');
    var type = val.slice(0, p);
    var a = findAsset(type, val.slice(p + 1));
