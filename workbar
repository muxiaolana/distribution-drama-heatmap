// 为所有维度树的每一层节点注入"编辑"图标
function injectTreeEditIcons() {
  var trees = document.querySelectorAll('[id^="tag-tree-"]');
  trees.forEach(function(tree){
    tree.querySelectorAll('.tree-item').forEach(function(item){
      // 跳过"+ 新增"类占位项
      if (item.textContent.indexOf('+ 新增') !== -1) return;
      if (item.querySelector('.tree-edit')) return;
      // 推断层级：所在 .tree-children 的嵌套深度 => 层级
      var depth = 1;
      var p = item.parentElement;
      while (p && p !== tree) {
        if (p.classList && p.classList.contains('tree-children')) depth++;
        p = p.parentElement;
      }
      var kind = depth === 1 ? '分类' : (depth === 2 ? '子分类' : '具体标签');
      // 取节点自身文本（排除 badge / arrow / 已有图标）
      var label = '';
      item.childNodes.forEach(function(n){
        if (n.nodeType === 3) label += n.textContent;
        else if (n.nodeType === 1 && !n.classList.contains('arrow') && !n.classList.contains('tree-badge') && !n.classList.contains('tree-edit')) label += n.textContent;
      });
      label = label.trim();
      var edit = document.createElement('span');
      edit.className = 'tree-edit';
      edit.textContent = '✎';
      edit.title = '编辑';
      // 若无 badge，图标需自行靠右
      if (!item.querySelector('.tree-badge')) edit.style.marginLeft = 'auto';
      else edit.style.marginLeft = '6px';
      edit.addEventListener('click', function(e){
        e.stopPropagation();
        openTagEdit(label, String(depth), kind);
      });
      item.appendChild(edit);
      // 记录节点信息，供右侧联动使用
      item.setAttribute('data-label', label);
      item.setAttribute('data-depth', String(depth));
      item.setAttribute('data-kind', kind);
      // 点击节点 => 右侧列表联动
      item.addEventListener('click', function(e){
        // 点击箭头（展开/收起）或编辑图标时不触发选中
        if (e.target.classList && (e.target.classList.contains('arrow') || e.target.classList.contains('tree-edit'))) return;
        selectTreeNode(item);
      });
    });
  });
}

// 计算某个树节点的面包屑路径（从顶层到当前节点）
function getTreeNodePath(item) {
  var parts = [];
  var cur = item;
  while (cur && cur.classList && cur.classList.contains('tree-item')) {
    var lbl = cur.getAttribute('data-label');
    if (!lbl) {
      lbl = '';
      cur.childNodes.forEach(function(n){
        if (n.nodeType === 3) lbl += n.textContent;
        else if (n.nodeType === 1 && !n.classList.contains('arrow') && !n.classList.contains('tree-badge') && !n.classList.contains('tree-edit')) lbl += n.textContent;
      });
      lbl = lbl.trim();
    }
    parts.unshift(lbl);
    // 向上寻找父级 tree-item：先找所在的 .tree-children，再取其前一个兄弟节点
    var container = cur.parentElement;
    while (container && !(container.classList && container.classList.contains('tree-children'))) {
      container = container.parentElement;
    }
    if (!container) break;
    var prev = container.previousElementSibling;
    cur = (prev && prev.classList && prev.classList.contains('tree-item')) ? prev : null;
  }
  return parts;
}

// 点击左侧树节点 => 右侧详情联动
function selectTreeNode(item) {
  // 高亮当前节点，清除其它节点选中态
  document.querySelectorAll('.tree-item.tree-active').forEach(function(n){ n.classList.remove('tree-active'); });
  item.classList.add('tree-active');

  var label = item.getAttribute('data-label') || '';
  var depth = parseInt(item.getAttribute('data-depth') || '1', 10);
  var kind = item.getAttribute('data-kind') || '分类';
  var path = getTreeNodePath(item);
  var breadcrumb = path.join(' > ');

  // 直接子节点（下一层）
  var container = item.nextElementSibling;
  var children = [];
  if (container && container.classList && container.classList.contains('tree-children')) {
    // 仅取直接子级 tree-item
    Array.prototype.slice.call(container.children).forEach(function(c){
      if (c.classList && c.classList.contains('tree-item')) {
        var cl = c.getAttribute('data-label');
        if (!cl) {
          cl = '';
          c.childNodes.forEach(function(n){
            if (n.nodeType === 3) cl += n.textContent;
            else if (n.nodeType === 1 && !n.classList.contains('arrow') && !n.classList.contains('tree-badge') && !n.classList.contains('tree-edit')) cl += n.textContent;
          });
          cl = cl.trim();
        }
        children.push(cl);
      }
    });
  }

  // 更新标题面包屑
  var titleEl = document.getElementById('tag-detail-title');
  if (titleEl) titleEl.textContent = breadcrumb || label;
  var subEl = document.getElementById('tag-detail-sub');
  if (subEl) {
    subEl.textContent = children.length ? ('— 共 ' + children.length + ' 个子标签') : ('— ' + kind + '，暂无子标签');
  }

  // 重新绑定"编辑"与"添加子标签"按钮上下文
  var editBtn = document.getElementById('tag-detail-edit-btn');
  if (editBtn) {
    editBtn.textContent = (kind === '具体标签') ? '编辑标签' : '编辑分类';
    editBtn.onclick = function(){ openTagEdit(label, String(depth), kind); };
  }
  var addBtn = document.getElementById('tag-detail-add-btn');
  if (addBtn) {
    addBtn.onclick = function(){ openTagSubAdd(breadcrumb || label); };
  }

  // 渲染子标签列表
  var tbody = document.getElementById('tag-detail-tbody');
  if (tbody) {
    if (children.length) {
      var rows = children.map(function(cn, i){
        var childDepth = depth + 1;
        var childKind = childDepth === 1 ? '分类' : (childDepth === 2 ? '子分类' : '具体标签');
        var mark = (i % 2 === 0)
          ? '<span class="pill pill-manual">人工</span>'
          : '<span class="pill pill-ai">AI</span>';
        var ownGroups = ['都市创意组1', '甜宠创意组2', '古言创意组3'];
        var own = (i % 3 === 0)
          ? '<span class="pill pill-public">公共</span>'
          : '<span class="pill pill-group">' + ownGroups[i % 3] + '</span>';
        return '<tr>' +
          '<td style="font-weight:500; color:#1e293b;">' + cn + '</td>' +
          '<td><span style="font-size:12px; color:#94a3b8;">第' + childDepth + '层 · ' + childKind + '</span></td>' +
          '<td>' + mark + '</td>' +
          '<td>' + own + '</td>' +
          '<td style="color:#94a3b8;">2026-0' + (1 + (i % 6)) + '-1' + (i % 9) + '</td>' +
          '<td>' +
            '<button class="btn btn-outline" style="padding:3px 8px; font-size:11px;" onclick="openTagEdit(\'' + cn + '\',\'' + childDepth + '\',\'' + childKind + '\')">编辑</button> ' +
            '<button class="btn btn-outline" style="padding:3px 8px; font-size:11px;" onclick="openTagSubAdd(\'' + (breadcrumb ? breadcrumb + ' > ' : '') + cn + '\')">添加子标签</button>' +
          '</td>' +
        '</tr>';
      }).join('');
      tbody.innerHTML = rows;
    } else {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:#94a3b8; padding:32px;">该节点为末级「' + kind + '」，暂无下级标签。可点击右上角「添加子标签」新建。</td></tr>';
    }
  }
}

