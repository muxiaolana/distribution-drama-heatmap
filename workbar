function uniqueObjName(base) {
  var name = base;
  if (oldObjSelected.indexOf(name) > -1) {
    var n = 2;
    while (oldObjSelected.indexOf(base + '(' + n + ')') > -1) n++;
    name = base + '(' + n + ')';
  }
  return name;
}

function fmtClock(sec) {
  sec = Math.max(0, Math.floor(sec || 0));
  var m = Math.floor(sec / 60), s = sec % 60;
  return (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
}
function fmtClockMs(sec) {
  var ms = Math.max(0, Math.round((sec || 0) * 1000));
  var m = Math.floor(ms / 60000), s = Math.floor((ms % 60000) / 1000), f = ms % 1000;
  return (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s) + '.' + ('00' + f).slice(-3);
}

function addLocalVideos(files) {
  var pending = files.length;
  var added = 0;
  files.forEach(function (f, k) {
    var base = f.name.replace(/\.[^.]+$/, '');
    var name = uniqueObjName(base);
    var url = '';
    try { url = (window.URL || window.webkitURL).createObjectURL(f); } catch (e) { url = ''; }
    oldObjSelected.push(name);
    oldObjClip[name] = { start: '00:00.000', end: '00:15.000' };
    oldObjExtra[name] = {
      source: 'local', url: url, fname: f.name,
      size: (f.size / 1024 / 1024).toFixed(1) + ' MB',
      duration: '', dramaId: '', bg: LOCAL_BG[(oldObjSelected.length + k) % LOCAL_BG.length]
    };
    added++;
    // 读取时长，自动收敛默认截取区间
    if (!url) { done(); return; }
    var v = document.createElement('video');
    v.preload = 'metadata';
    v.onloadedmetadata = function () {
      var d = v.duration;
      if (isFinite(d) && d > 0) {
        oldObjExtra[name].duration = fmtClock(d);
        oldObjClip[name].end = fmtClockMs(Math.min(15, d));
      }
      done();
    };
    v.onerror = done;
    v.src = url;
    function done() { if (--pending === 0) renderOldObjList(); }
  });
  renderOldObjList();
  if (added) {
    alert('已添加 ' + added + ' 个本地视频作为操作对象，可在列表中调整截取区间与参考内容。');
  }
}

